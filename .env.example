APP_NAME="Sports Junction"
APP_TAGLINE="India's Sports Manufacturing Marketplace"
APP_ENV=local
APP_DEBUG=false
APP_URL="http://localhost/Antigravity/Sports-Junction"
SESSION_LIFETIME=7200

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
DB_DATABASE=sports_junction
DB_USERNAME=root
DB_PASSWORD=

# Super Admin Initial Credentials
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=sportjunctions@gmail.com
SUPER_ADMIN_PASSWORD=Sport@123

# Mail Delivery Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sportjunctions@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sportjunctions@gmail.com
MAIL_FROM_NAME="Sports Junction Marketplace"
