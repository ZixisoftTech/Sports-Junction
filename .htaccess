<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if already rewritten to public/
    RewriteCond %{REQUEST_URI} !public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect hidden system files (.env, .git, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
